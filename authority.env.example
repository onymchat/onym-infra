# Copy to authority.env and fill in. Mounted into the moderation
# authority via docker-compose `env_file`. Never committed (see
# .gitignore). AUTHORITY_BIND, the store path, the manifest path and
# the interface URL are set by docker-compose — don't set them here.
# Full list: onym-moderation/authority/src/config.rs, which documents
# every variable in its `usage()`.

# Ed25519 seed for the verdict-signing key, 64 hex chars. REQUIRED —
# the service refuses to boot without it.
#   openssl rand -hex 32
# Keep it separate from operational secrets, and never rotate it while
# bans are running: verdicts already issued would stop verifying.
AUTHORITY_SIGNING_SEED=

# The token this authority presents to the interface when delivering a
# verdict. Must equal MODERATION_AUTHORITY_TOKEN in moderation.env —
# it is one shared token, and two separately rotated values are just a
# delivery outage waiting to happen.
AUTHORITY_INTERFACE_TOKEN=

# Per-interface delivery routes: <componentId>=<url>|<token>, comma
# separated. REQUIRED for the Android interface — without its entry,
# verdicts for onym:component:onym-android mandates fall through to
# the default route above and land on the APPLE interface, which
# never countersigned them (no_mandate, permanently). The token is
# the Android backend's MODERATION_AUTHORITY_TOKEN
# (moderation-android.env) — one shared secret seen from two sides,
# same pattern as AUTHORITY_INTERFACE_TOKEN. deploy.sh refuses to
# run without a well-formed entry.
#   AUTHORITY_INTERFACE_ROUTES=onym:component:onym-android=https://moderation-android.onym.app|<token>
AUTHORITY_INTERFACE_ROUTES=

# Optional bearer token for POST /v1/cases/:id/decide. This is the JSON
# automation route; the admin panel below can decide cases without it.
AUTHORITY_MODERATOR_TOKEN=

# Bearer token for the moderator panel at /admin. REQUIRED in this
# deployment because autonomous triage is off: its deadline-ordered
# queue is where humans decide every first-instance case, and it is the
# implemented route for appeals and new-holder claims. The panel shows
# disclosed evidence, so keep this secret.
AUTHORITY_ADMIN_TOKEN=

# Only if you enable AUTHORITY_TRIAGE_MODE and your local inference
# server wants a key. Triage is off in this stack — turning it on means
# adding a model container, because the authority is built to reach a
# sibling on the private network rather than ship case evidence to
# somebody else's API.
# AUTHORITY_TRIAGE_API_KEY=
