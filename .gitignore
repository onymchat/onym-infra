# Secrets — never commit
.env
relayer.env
moderation.env
moderation-android.env
authority.env
backup.env

# Deployment-generated public artifacts. The authority manifest is
# materialized from the reference template plus the deployment key.
runtime/

# The Apple DeviceCheck signing key, wherever it lands.
*.p8

# Local noise
*.log
.DS_Store

# Claude Code session state (worktrees contain embedded git repos).
.claude/

# Terraform/OpenTofu local state — provider binaries are hundreds of
# MB (they broke a push once) and state can embed credentials.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
