# Copy to moderation.env and fill in. Mounted into the enforcement
# backend ("the interface") via docker-compose `env_file`. Never
# committed (see .gitignore). MODERATION_BIND, the store path and the
# non-secret settings are set by docker-compose and .env — don't set
# them here. Full list: onym-moderation/apple/src/config.rs.

# The Apple DeviceCheck signing key, i.e. the contents of
# AuthKey_<KEYID>.p8, on ONE line with newlines written as \n. The
# service un-escapes them. There is a MODERATION_DEVICECHECK_KEY_PATH
# alternative upstream, but this stack has nowhere to mount a file the
# GitHub Actions deploy could also produce, so the inline form is the
# one that works both ways. REQUIRED to read or write device marks —
# without it the gate never answers "clear".
MODERATION_DEVICECHECK_KEY_PEM=

# The 10-character DeviceCheck key id and Apple team id that go with it.
MODERATION_DEVICECHECK_KEY_ID=
MODERATION_DEVICECHECK_TEAM_ID=

# Ed25519 seed for the interface's countersigning key, 64 hex chars.
# REQUIRED — the service refuses to boot without it.
#   openssl rand -hex 32
# The matching public key is logged at boot as "interface
# countersigning key"; that is what AUTHORITY_INTERFACE_KEY in .env
# wants.
MODERATION_INTERFACE_SIGNING_SEED=


# Bearer token an authority presents on POST /v1/verdicts. This is the
# SAME value as AUTHORITY_INTERFACE_TOKEN in authority.env — one shared
# token seen from two sides. Without it the endpoint refuses every
# request, which is the intended failure: an open verdict endpoint is
# an unauthenticated write into the store.
MODERATION_AUTHORITY_TOKEN=

# Bearer token for GET /v1/write-log. The log names every device
# binding, verdict and mark transition, so leaving this empty closes
# the endpoint rather than opening it.
MODERATION_AUDIT_TOKEN=
