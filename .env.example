# Copy to .env and fill in. Consumed by deploy/digitalocean/deploy.sh
# (DO/CF tokens) and by docker compose (hostnames + Caddy email).
# deploy.sh uploads ONLY the compose-relevant vars to the droplet —
# the DO/CF tokens stay local.

# --- Credentials (local only, never uploaded) ---
# DigitalOcean API token (doctl).
DO_API_KEY=
# Cloudflare API token with DNS:Edit on the onym.app zone.
CF_API_TOKEN=

# --- Domain / hostnames (uploaded; consumed by Caddy) ---
DOMAIN=onym.app
NOSTR_HOST=nostr.onym.app
BLOSSOM_HOST=blossom.onym.app
RELAYER_HOST=relayer.onym.app
MODERATION_HOST=moderation.onym.app
# The deploy materializes the authority manifest for this host, so its
# policy URLs follow this value instead of pointing back at production.
AUTHORITY_HOST=authority.onym.app

# Email for the Let's Encrypt account (cert-expiry notices).
CADDY_EMAIL=rinat@qda.one

# --- Moderation settings (uploaded; non-secret) ---
# The two services' secrets are NOT here: they live in moderation.env
# and authority.env, the same way the relayer's live in relayer.env.
# Only settings an operator would happily read out loud belong below.

# Which Apple DeviceCheck environment to talk to: production or
# development. A device's bits are per-environment, so switching this
# is switching to a different set of marks.
MODERATION_DEVICECHECK_ENV=production

# Whether the interface requires a verdict to carry a signature that
# verifies against the authority's published key. Keep this true. The
# deploy derives that key and materializes the manifest before either
# service starts, so there is no unsigned bootstrap window.
MODERATION_ENFORCE_SIGNATURES=true

# Per-authority interface countersigning epochs, <componentId>=<epoch>
# comma separated. Empty means every authority is on epoch 0 — the
# interface's root seed used directly — which is the un-rotated state
# and needs no entry. Not a secret: an epoch says which key is in
# force, never what it is. See "Rotating an authority's countersigning
# key" in the README before changing it.
MODERATION_INTERFACE_KEY_EPOCHS=

# The interface's PUBLIC countersigning key, onym:key:<hex>. Derived
# from MODERATION_INTERFACE_SIGNING_SEED, so it cannot be known before
# the interface first boots: leave it empty, then read
# `interfaceKey` from https://$MODERATION_HOST/health and put it
# here.
AUTHORITY_INTERFACE_KEY=

# --- Droplet ---
DO_REGION=ams3
DO_DROPLET_SIZE=s-1vcpu-2gb
SSH_KEY_PATH=$HOME/.ssh/id_ed25519

# Populated by deploy.sh after the first run so re-runs reuse the box.
DROPLET_ID=
DROPLET_IP=
