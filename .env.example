# Copy to .env and fill in. Consumed by deploy/digitalocean/deploy.sh
# (DO/CF tokens) and by docker compose (hostnames + Caddy email).
# deploy.sh uploads ONLY the compose-relevant vars to the droplet —
# the DO/CF tokens stay local.

# --- Credentials (local only, never uploaded) ---
# DigitalOcean API token (doctl).
DO_API_KEY=
# Cloudflare API token with DNS:Edit on the onym.app zone.
CF_API_TOKEN=

# --- Domain / hostnames (uploaded; consumed by Caddy) ---
DOMAIN=onym.app
NOSTR_HOST=nostr.onym.app
BLOSSOM_HOST=blossom.onym.app
RELAYER_HOST=relayer.onym.app
MODERATION_HOST=moderation.onym.app
MODERATION_ANDROID_HOST=moderation-android.onym.app
# The deploy materializes the authority manifest for this host, so its
# policy URLs follow this value instead of pointing back at production.
AUTHORITY_HOST=authority.onym.app

# Email for the Let's Encrypt account (cert-expiry notices).
CADDY_EMAIL=rinat@qda.one

# --- Moderation settings (uploaded; non-secret) ---
# The two services' secrets are NOT here: they live in moderation.env
# and authority.env, the same way the relayer's live in relayer.env.
# Only settings an operator would happily read out loud belong below.

# Which Apple DeviceCheck environment to talk to: production or
# development. A device's bits are per-environment, so switching this
# is switching to a different set of marks.
MODERATION_DEVICECHECK_ENV=production

# Whether the interface requires a verdict to carry a signature that
# verifies against the authority's published key. Keep this true. The
# deploy derives that key and materializes the manifest before either
# service starts, so there is no unsigned bootstrap window.
MODERATION_ENFORCE_SIGNATURES=true

# Per-authority interface countersigning epochs, <componentId>=<epoch>
# comma separated. Empty means every authority is on epoch 0 — the
# interface's root seed used directly — which is the un-rotated state
# and needs no entry. Not a secret: an epoch says which key is in
# force, never what it is. See "Rotating an authority's countersigning
# key" in the README before changing it.
MODERATION_INTERFACE_KEY_EPOCHS=

# The interface's PUBLIC countersigning key, onym:key:<hex>. Derived
# from MODERATION_INTERFACE_SIGNING_SEED, so it cannot be known before
# the interface first boots: leave it empty, then read
# `interfaceKey` from https://$MODERATION_HOST/health and put it
# here.
AUTHORITY_INTERFACE_KEY=

# --- Android moderation settings (uploaded; non-secret) ---
# The Android interface's secrets live in moderation-android.env.

# Which app a decoded Play Integrity token must name (classifier
# condition 1). Public knowledge; the default matches the workflow's.
MODERATION_PLAY_PACKAGE_NAME=app.onym.android

# The Play App Signing certificate SHA-256 digest(s) a token must
# carry, comma separated — in Google's TOKEN spelling
# (base64url-nopad), NOT the Play Console's colon-hex. Convert:
#   echo "<COLON:HEX>" | tr -d ':' | xxd -r -p | base64 | tr '+/' '-_' | tr -d '='
# May stay empty while the service runs degraded (no
# MODERATION_PLAY_SA_KEY_JSON); deploy.sh requires it once the SA key
# is present, because key-without-digests silently stays degraded.
MODERATION_PLAY_CERT_SHA256_DIGESTS=

# Same shape as MODERATION_INTERFACE_KEY_EPOCHS, for the Android
# interface's per-authority countersigning epochs.
MODERATION_ANDROID_INTERFACE_KEY_EPOCHS=

# The Android interface's component id. The default is correct;
# documented here only so the knob is findable.
MODERATION_ANDROID_INTERFACE_COMPONENT_ID=onym:component:onym-android

# Per-interface countersigning keys for the authority:
# onym:component:onym-android=<onym:key:hex>. Like
# AUTHORITY_INTERFACE_KEY it cannot be known before the Android
# interface first boots: leave it empty, read `interfaceKey` from
# https://$MODERATION_ANDROID_HOST/health, put it here, re-run.
# Scoped per component so one interface's key cannot witness mandates
# naming the other.
AUTHORITY_INTERFACE_KEYS_BY_COMPONENT=

# Human moderation QA: keep triage off and allow the panel to exercise a
# ban without waiting days for the consented response window.
AUTHORITY_TRIAGE_MODE=off
AUTHORITY_QA_ALLOW_EARLY_BAN=true

# --- Container images (local only, never uploaded) ---
# Name of the DigitalOcean container registry to build into and pull
# from. Set it and the droplet stops compiling Rust: images are built
# where this script runs, tagged with the submodule commit, and pulled
# on the far end. Leave it empty to keep building in place.
#
# It authenticates with DO_API_KEY above, so it needs no new secret —
# only a one-time `doctl registry create <name> --region ams3`. There is
# exactly one registry per DigitalOcean account, and this must be its
# name. Requires docker + buildx locally.
DOCR_NAME=

# --- Droplet ---
DO_REGION=ams3
DO_DROPLET_SIZE=s-1vcpu-2gb
SSH_KEY_PATH=$HOME/.ssh/id_ed25519

# Populated by deploy.sh after the first run so re-runs reuse the box.
DROPLET_ID=
DROPLET_IP=
