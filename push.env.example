# Copy to push.env and fill in. Mounted into the push backend via
# docker-compose `env_file`. Never committed (see .gitignore).
# PUSH_BIND, the store path and the non-secret settings are set by
# docker-compose and .env — don't set them here. Full list:
# onym-push/apple/src/config.rs.

# The APNs signing key, i.e. the contents of AuthKey_<KEYID>.p8, on ONE
# line with newlines written as \n. The service un-escapes them. There
# is a PUSH_APNS_KEY_PATH alternative upstream, but this stack has
# nowhere to mount a file the GitHub Actions deploy could also produce,
# so the inline form is the one that works both ways. Without it the
# service registers devices and delivers nothing.
PUSH_APNS_KEY_PEM=

# The 10-character APNs key id and Apple team id that go with it.
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=

# The app bundle id, sent as apns-topic.
PUSH_APNS_BUNDLE_ID=app.onym.ios

# Apple DeviceCheck key for registration abuse resistance. May be the
# SAME .p8 as the APNs key if that key has both capabilities enabled —
# set all three regardless. Without these, registrations are accepted
# on the session signature alone.
PUSH_DEVICECHECK_KEY_PEM=
PUSH_DEVICECHECK_KEY_ID=
PUSH_DEVICECHECK_TEAM_ID=
