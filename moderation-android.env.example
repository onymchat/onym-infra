# Copy to moderation-android.env and fill in. Mounted into the Android
# enforcement backend via docker-compose `env_file`. Never committed
# (see .gitignore). MODERATION_BIND, the store path, the package name /
# cert digests and the other non-secret settings are set by
# docker-compose and .env — don't set them here. Full list:
# onym-moderation/android/src/config.rs.

# The Google Cloud service-account JSON key of the project linked in
# the Play Console (Play Integrity API enabled), on ONE line — it is
# already one line as downloaded unless an editor re-wrapped it. There
# is a MODERATION_PLAY_SA_KEY_PATH alternative upstream, but this stack
# has nowhere to mount a file the GitHub Actions deploy could also
# produce, so the inline form is the one that works both ways.
#
# Without it the service still boots and countersigns, but every gate
# check answers checkRequired — degraded toward blocking. That is the
# expected state until Google approves device-recall access.
#
# ABSENT, not empty: an empty value is still parsed (and refused) by
# the service. Leave the line commented out until you have the key.
# MODERATION_PLAY_SA_KEY_JSON=

# Ed25519 seed for THIS interface's countersigning key, 64 hex chars.
# REQUIRED — the service refuses to boot without it. A DIFFERENT seed
# from the Apple interface's: they are different components
# (onym:component:onym-android vs onym:component:onym-ios) and their
# countersignatures must not be interchangeable.
#   openssl rand -hex 32
# The matching public key is on /health as `interfaceKey`; that is
# what the onym:component:onym-android entry in
# AUTHORITY_INTERFACE_KEYS_BY_COMPONENT (.env) wants.
MODERATION_INTERFACE_SIGNING_SEED=

# Bearer token an authority presents on POST /v1/verdicts. This is the
# SAME value carried in the authority's AUTHORITY_INTERFACE_ROUTES
# entry for onym:component:onym-android (authority.env) — one shared
# token seen from two sides. Without it the endpoint refuses every
# request, which is the intended failure.
MODERATION_AUTHORITY_TOKEN=

# Bearer token for GET /v1/write-log. Empty closes the endpoint.
MODERATION_AUDIT_TOKEN=
