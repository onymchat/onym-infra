# Caddy handles TLS automatically for each site below: it obtains a
# Let's Encrypt certificate on first request and renews it well before
# expiry. No certbot, no cron. For this to work every hostname below
# must resolve to this host and be DNS-only (grey-cloud) in Cloudflare
# so the ACME challenge reaches Caddy directly.
#
# reverse_proxy transparently forwards WebSocket upgrades, so the Nostr
# `wss://` and Blossom paths need no special directives.
{
	email {$CADDY_EMAIL}
}

# Nostr relay (strfry) — long-lived WebSocket connections. strfry reads
# the client IP from x-real-ip (see strfry.conf realIpHeader), which
# Caddy doesn't send by default, so set it explicitly.
{$NOSTR_HOST} {
	reverse_proxy nostr-relay:7777 {
		header_up X-Real-IP {remote_host}
	}
}

# Blossom media/blob server — allow large uploads (images, video).
{$BLOSSOM_HOST} {
	request_body {
		max_size 100MB
	}
	reverse_proxy blossom:3000
}

# Soroban contract relayer.
{$RELAYER_HOST} {
	reverse_proxy relayer:8080
}

# Moderation enforcement backend (the interface). Plain JSON over
# GET/POST — no websockets, and no request_body override because the
# service caps bodies at 256 KiB itself, which is the limit that should
# win.
{$MODERATION_HOST} {
	encode zstd gzip
	reverse_proxy moderation:8080
}

# Android moderation enforcement backend. Same posture as its Apple
# sibling above: plain JSON, the service's own 256 KiB body cap wins.
{$MODERATION_ANDROID_HOST} {
	encode zstd gzip
	reverse_proxy moderation-android:8080
}

# Moderation authority. It caps request bodies at 1 MiB itself (the
# interface above uses 256 KiB). `/manifest.json` is deliberately
# public: people have to be able to read the classes, terms and appeal
# path *before* consenting, and anyone should be able to check a
# mandate's pinned hash against what this authority publishes.
{$AUTHORITY_HOST} {
	encode zstd gzip
	# The manifest's detached operator signature, produced at deploy
	# time by `sign-manifest` over the exact materialized bytes.
	# Served by Caddy because the authority serves only /manifest.json
	# and /v1/*; clients fetch `<manifest-url>.sig` and verify before
	# trusting the manifest's terms.
	handle /manifest.json.sig {
		root * /srv/authority-manifest
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	# The manifest links out to the ten documents its terms are
	# written in — /policy/csam, /policy/evidence-rules,
	# /policy/retention, and seven more. Those are what a user reads *before* consenting, so a 404
	# here means the term was never published and nobody agreed to it.
	# The authority itself serves only /manifest.json and /v1/*, which
	# leaves the routing to Caddy.
	handle_path /policy/* {
		root * /srv/policy
		# The manifest's URLs carry no extension. They carry no
		# fragments either: every term, including each violation class,
		# is its own document, so a link resolves to exactly the text
		# it names and nothing depends on anchors.
		try_files {path} {path}.md
		# Caddy's MIME table has no entry for .md, so without this the
		# browser is handed application/octet-stream and downloads the
		# terms instead of showing them. The documents go out as the
		# published Markdown itself rather than as rendered HTML: these
		# are the bytes that were signed off, and serving them verbatim
		# keeps what a user reads identical to what was reviewed.
		header Content-Type "text/markdown; charset=utf-8"
		file_server
	}

	reverse_proxy authority:8080
}

# Onym Discovery provider — a static, signed directory tree published
# by the onym-discovery repo's Deploy workflow into /var/www/discovery
# on this droplet (mounted at /srv/discovery below in compose). This
# stack owns only the vhost; the artifacts (manifest.json, chained
# catalog snapshots, seat manifests, policy/privacy documents) are
# signed, verified and rsynced by that workflow — see README "The
# discovery static seat". An empty web root is a valid degraded state:
# the vhost answers 404s (and still gets its certificate) until the
# first discovery publish lands.
#
# Static files only; the signed JSON must go out byte-for-byte (encode
# is transfer compression, not re-serialization). .sig files are
# detached Ed25519 signatures — text/plain, matching how the
# authority's manifest.json.sig is served above. The policy and privacy
# documents go out as the Markdown that was signed off, verbatim, for
# the same reason the authority's terms do: without the header Caddy
# hands the browser application/octet-stream and it downloads instead
# of showing them.
{$DISCOVERY_HOST} {
	encode zstd gzip
	root * /srv/discovery
	@sig path *.sig
	header @sig Content-Type "text/plain; charset=utf-8"
	@md path *.md
	header @md Content-Type "text/markdown; charset=utf-8"
	file_server
}
