# Caddy handles TLS automatically for each site below: it obtains a
# Let's Encrypt certificate on first request and renews it well before
# expiry. No certbot, no cron. For this to work every hostname below
# must resolve to this host and be DNS-only (grey-cloud) in Cloudflare
# so the ACME challenge reaches Caddy directly.
#
# reverse_proxy transparently forwards WebSocket upgrades, so the Nostr
# `wss://` and Blossom paths need no special directives.
{
	email {$CADDY_EMAIL}
}

# Nostr relay (strfry) — long-lived WebSocket connections. strfry reads
# the client IP from x-real-ip (see strfry.conf realIpHeader), which
# Caddy doesn't send by default, so set it explicitly.
{$NOSTR_HOST} {
	reverse_proxy nostr-relay:7777 {
		header_up X-Real-IP {remote_host}
	}
}

# Blossom media/blob server — allow large uploads (images, video).
{$BLOSSOM_HOST} {
	request_body {
		max_size 100MB
	}
	reverse_proxy blossom:3000
}

# Soroban contract relayer.
{$RELAYER_HOST} {
	reverse_proxy relayer:8080
}

# Moderation enforcement backend (the interface). Plain JSON over
# GET/POST — no websockets, and no request_body override because the
# service caps bodies at 256 KiB itself, which is the limit that should
# win.
{$MODERATION_HOST} {
	reverse_proxy moderation:8080
}

# Moderation authority. Same shape, and note that `/manifest.json` is
# deliberately public: people have to be able to read the classes,
# terms and appeal path *before* consenting, and anyone should be able
# to check a mandate's pinned hash against what this authority
# publishes.
{$AUTHORITY_HOST} {
	# The manifest links out to the documents its terms are written in
	# — /policy/classes#csam, /policy/evidence-rules, and five more.
	# Those are what a user reads *before* consenting, so a 404 here
	# means the term was never published and nobody agreed to it. The
	# authority itself serves only /manifest.json and /v1/*, which
	# leaves the routing to Caddy.
	handle_path /policy/* {
		root * /srv/policy
		# The manifest's URLs carry no extension, and `#csam` is a
		# fragment within classes.md rather than a document of its own.
		try_files {path} {path}.md
		# Caddy's MIME table has no entry for .md, so without this the
		# browser is handed application/octet-stream and downloads the
		# terms instead of showing them. This serves the published
		# Markdown as-is: honest about what the bytes are, but it does
		# mean the manifest's `#csam` style fragments do not resolve to
		# anything, because fragments address HTML elements. See the
		# open question in the pull request — rendering these to HTML
		# at deploy time, or giving each class its own document, are
		# both live options and both are a decision rather than a fix.
		header Content-Type "text/markdown; charset=utf-8"
		file_server
	}

	reverse_proxy authority:8080
}
